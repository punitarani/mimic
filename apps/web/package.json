{
  "name": "@mimic/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "gen:autocomplete": "pnpm --dir scripts/autocomplete install --ignore-workspace --frozen-lockfile && node scripts/autocomplete/gen.mjs",
    "gen:share-card": "pnpm --dir scripts/share-card install --ignore-workspace --frozen-lockfile && NODE_USE_ENV_PROXY=1 node --import tsx scripts/share-card/gen.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@mimic/adapters": "workspace:*",
    "@mimic/core": "workspace:*",
    "@mimic/db": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.7",
    "@tanstack/query-async-storage-persister": "^5.104.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-persist-client": "^5.104.0",
    "d3-force": "^3.0.0",
    "downshift": "^9.4.0",
    "idb-keyval": "^6.3.0",
    "next": "16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vitest": "~4.1.11",
    "wrangler": "^4.144.0"
  }
}
